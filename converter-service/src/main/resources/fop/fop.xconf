<?xml version="1.0" encoding="UTF-8"?>
<fop version="1.0">
    <strict-validation>true</strict-validation>
    <strict-configuration>true</strict-configuration>
    <base>./</base>
    <renderers>
        <renderer mime="application/pdf">
            <fonts>
                <directory recursive="true">./fonts</directory>
                <auto-detect />
                <font kerning="yes" embed-url="file:/app/fonts/DejaVuSans.ttf">
                    <font-triplet name="DejaVu Sans" style="normal" weight="normal" />
                </font>
            </fonts>
        </renderer>
        <renderer mime="application/postscript" />
        <renderer mime="application/x-pcl" />
        <renderer mime="application/x-afp" />
        <renderer mime="image/x-afp+ioca" />
        <renderer mime="application/rtf" />
    </renderers>
</fop>