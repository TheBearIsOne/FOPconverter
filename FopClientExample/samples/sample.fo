<?xml version="1.0" encoding="UTF-8"?>
<fo:root xmlns:fo="http://www.w3.org/1999/XSL/Format">
  <fo:layout-master-set>
    <fo:simple-page-master master-name="simple" page-width="21cm" page-height="29.7cm" margin="1.5cm">
      <fo:region-body/>
    </fo:simple-page-master>
  </fo:layout-master-set>
  <fo:page-sequence master-reference="simple">
    <fo:flow flow-name="xsl-region-body" font-family="DejaVu Sans, Liberation Sans, Arial, Segoe UI, Helvetica">
      <fo:block font-size="18pt" font-weight="bold" space-after="10pt">FOP Converter Demo</fo:block>
      <fo:block>Синхронный пример конвертации XSL-FO в PDF.</fo:block>
    </fo:flow>
  </fo:page-sequence>
</fo:root>